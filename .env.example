# Copy to .env and fill in. No URL is baked into the build.

# PostgreSQL
DB_URL=jdbc:postgresql://host:5432/database?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Port this API listens on. Optional, defaults to 8080.
SERVER_PORT=8080

# Browser origins allowed to call /api/**, comma separated. Required.
# The * wildcard is allowed, so http://localhost:* covers the random port a
# Flutter web dev server picks, and a deployed client is named exactly:
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://vms.example.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# Base64 signing key of at least 32 random bytes
APP_JWT_SECRET=

# First-run operator account
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Optional
APP_TOKEN_LIFETIME_SECONDS=900
APP_MAX_PASSWORD_BYTES=72
